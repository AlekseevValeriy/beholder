<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Beholder.Views.AddressEnter"
             xmlns:vm="clr-namespace:Beholder.ViewModels"
             x:DataType="vm:AddressEnterViewModel"
             Title="AddressEnter">
    <Grid RowDefinitions="auto,*,auto" RowSpacing="12">
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Primary}"
                HeightRequest="50"
                Padding="12,0"
                Stroke="{StaticResource Primary}">
            <Label Text="Телегид от Vua rera"
                   FontSize="24"
                   TextColor="White"
                   VerticalOptions="Center" />
        </Border>
        <VerticalStackLayout Grid.Row="1"
                             Margin="12"
                             Spacing="18">
            <Label Grid.Row="0"
                   VerticalOptions="Center"
                   Text="Адрес сервера" />
            <Entry Grid.Row="1"
                   Placeholder="https://..."
                   Text="{Binding Address}" />
        </VerticalStackLayout>
        <Border Grid.Row="2"
                BackgroundColor="Transparent"
                HeightRequest="60"
                StrokeThickness="0">
            <Grid Margin="6,0"
                  ColumnDefinitions="*,auto,*">
                <Button Grid.Column="1"
                        BackgroundColor="{StaticResource Primary}"
                        HorizontalOptions="Center"
                        HeightRequest="40"
                        Text="Продолжить"
                        WidthRequest="150"
                        Command="{Binding ToShellCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Beholder.Views.AddressEnter"
             xmlns:vm="clr-namespace:Beholder.ViewModels"
             x:DataType="vm:AddressEnterViewModel"
             Title="AddressEnter">
    <Grid RowDefinitions="auto,*">
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                         Dark={StaticResource PrimaryDark}}"
                HeightRequest="50"
                Stroke="{StaticResource Primary}">
        </Border>

        <Grid Grid.Row="1" RowDefinitions="*,auto" Margin="12">
            <Grid Grid.Row="0" RowSpacing="10"
                  RowDefinitions="auto,auto"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0" Text="Адрес сервера"/>
                <Entry Grid.Row="1" WidthRequest="200" Text="{Binding Address}"/>
            </Grid>
            <Button Grid.Row="1" HorizontalOptions="Center"
                    HeightRequest="40"
                    Text="Продолжить"
                    WidthRequest="150" Command="{Binding ToShellCommand}"/>
        </Grid>

    </Grid>
</ContentPage>
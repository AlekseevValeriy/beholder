<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Beholder.Views.AddressEnter"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Beholder.ViewModels"
    Title="AddressEnter"
    x:DataType="vm:AddressEnterViewModel">
    <Grid RowDefinitions="auto,*,auto" RowSpacing="12">
        <Border
            Grid.Row="0"
            Padding="12,0"
            BackgroundColor="{StaticResource Primary}"
            HeightRequest="50"
            Stroke="{StaticResource Primary}">
            <Label
                FontSize="24"
                Text="Телегид от Vua rera"
                TextColor="{AppThemeBinding Light={StaticResource BarTextLight},
                                            Dark={StaticResource BarTextDark}}"
                VerticalOptions="Center" />
        </Border>
        <VerticalStackLayout
            Grid.Row="1"
            Margin="12"
            Spacing="18">
            <Label
                Grid.Row="0"
                Text="Адрес сервера"
                TextColor="{AppThemeBinding Dark={StaticResource PrimaryTextDark},
                                            Light={StaticResource PrimaryTextLight}}"
                VerticalOptions="Center" />
            <Entry
                Grid.Row="1"
                Placeholder="https://..."
                Text="{Binding Address}" />
        </VerticalStackLayout>
        <Border
            Grid.Row="2"
            BackgroundColor="Transparent"
            HeightRequest="60"
            StrokeThickness="0">
            <Grid Margin="6,0" ColumnDefinitions="*,auto,*">
                <Button
                    Grid.Column="1"
                    BackgroundColor="{StaticResource Primary}"
                    Command="{Binding ToShellCommand}"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Text="Продолжить"
                    WidthRequest="150" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Beholder.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Beholder.Controls"
    xmlns:converters="clr-namespace:Beholder.Converters"
    xmlns:models="clr-namespace:Beholder.Models"
    xmlns:vm="clr-namespace:Beholder.ViewModels"
    x:DataType="vm:SearchPageViewModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BooleanInverse x:Key="BooleanInverse" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="auto,*">
        <Border
            Grid.Row="0"
            Padding="10,6"
            BackgroundColor="{StaticResource Primary}"
            HeightRequest="50"
            Stroke="{StaticResource Primary}">
            <SearchBar
                Grid.Column="0"
                FontSize="14"
                MinimumHeightRequest="30"
                SearchCommand="{Binding SearchCommand}"
                Text="{Binding SearchQuery}"
                TextColor="{AppThemeBinding Light={StaticResource BarTextLight},
                                            Dark={StaticResource BarTextDark}}" />
        </Border>
        <Grid Grid.Row="1">
            <Grid IsVisible="{Binding IsLoadSucces}">
                <CollectionView
                    Margin="12"
                    IsVisible="{Binding IsBusy, Converter={StaticResource BooleanInverse}}"
                    ItemsSource="{Binding ChannelsQueryResult}"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChannelResponse">

                            <controls:Channel
                                Title="{Binding name}"
                                ChannelId="{Binding id}"
                                Description="{Binding description}"
                                Image="{Binding icon_path}"
                                Number="{Binding number}"
                                Tags="{Binding tags}"
                                TapCommand="{Binding BindingContext.OpenTeleprogramPageCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" />

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Scale="1" />
            </Grid>
            <ContentView Content="{Binding ProblemContent}" IsVisible="{Binding IsLoadSucces, Converter={StaticResource BooleanInverse}}" />
        </Grid>

    </Grid>

</ContentPage>

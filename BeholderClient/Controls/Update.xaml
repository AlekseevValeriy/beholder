<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Beholder.Controls.Update"
             xmlns:controls="clr-namespace:Beholder.Controls"
             x:DataType="controls:Update"
             x:Name="This">
    <Image x:Name="UpdateIcon"
           Source="{AppThemeBinding Light=update_light.png, Dark=update_dark.png}"
           x:DataType="controls:Update"
           BindingContext="{Reference This}"
           WidthRequest="{Binding WidthRequest}"
           HeightRequest="{Binding HeightRequest}"
           IsVisible="{Binding IsVisible}">
        <Image.GestureRecognizers>
            <TapGestureRecognizer  Tapped="ClickedCommand"/>
        </Image.GestureRecognizers>
    </Image>
</ContentView>

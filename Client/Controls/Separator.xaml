<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Beholder.Controls.Separator"
             xmlns:controls="clr-namespace:Beholder.Controls"
             x:DataType="controls:Separator"
             x:Name="This">
    <VerticalStackLayout Spacing="12">
        <Border BackgroundColor="Transparent"
                x:DataType="controls:Separator"
                BindingContext="{Reference This}"
                HeightRequest="8"
                IsVisible="{Binding IsVisible}"
                StrokeThickness="0" />
        <Line HorizontalOptions="Center"
              x:DataType="controls:Separator"
              BindingContext="{Reference This}"
              IsVisible="{Binding IsVisible}"
              Stroke="{AppThemeBinding Light={StaticResource SeparatorLight}, Dark={StaticResource SeparatorDark}}"
              StrokeThickness="2"
              X1="0"
              X2="250"
              Y1="0"
              Y2="0" />
        <Border BackgroundColor="Transparent"
                x:DataType="controls:Separator"
                BindingContext="{Reference This}"
                HeightRequest="8"
                IsVisible="{Binding IsVisible}"
                StrokeThickness="0" />
    </VerticalStackLayout>
</ContentView>

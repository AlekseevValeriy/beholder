<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Beholder.Controls.ShortChannel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Beholder.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    x:Name="This"
    x:DataType="controls:ShortChannel">
    <Border
        Margin="18,8"
        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight},
                                          Dark={StaticResource SurfaceDark}}"
        StrokeShape="RoundRectangle 10">
        <Border.Shadow>
            <OnPlatform x:TypeArguments="Shadow">
                <On Platform="Android">
                    <On.Value>
                        <Shadow
                            Brush="{StaticResource PrimaryShadowAndroid}"
                            Opacity="0.5"
                            Radius="5" />
                    </On.Value>
                </On>
                <On Platform="WinUI">
                    <On.Value>
                        <Shadow
                            Brush="{StaticResource PrimaryShadowWinUI}"
                            Opacity="1.2"
                            Radius="5" />
                    </On.Value>
                </On>
            </OnPlatform>
        </Border.Shadow>
        <Grid
            Padding="12,6"
            ColumnDefinitions="auto,*"
            ColumnSpacing="24">
            <controls:ChannelImage
                Grid.RowSpan="2"
                Grid.Column="0"
                x:DataType="controls:ShortChannel"
                BindingContext="{x:Reference This}"
                Image="{Binding Image}" />
            <Label
                Grid.Column="1"
                x:DataType="controls:ShortChannel"
                BindingContext="{x:Reference This}"
                FontAttributes="Bold"
                FontSize="24"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                Text="{Binding Title}"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight},
                                            Dark={StaticResource PrimaryTextDark}}"
                VerticalOptions="Center" />
        </Grid>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OpenTeleprogramPage" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
